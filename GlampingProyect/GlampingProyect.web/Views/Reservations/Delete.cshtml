@model GlampingProyect.Web.Data.DTOs.ReservationDTO

@{
    ViewData["Title"] = "Eliminar Reserva";
}

<h1>¿Estás seguro de que deseas eliminar esta reserva?</h1>

<div>
    <h4>Reserva #@Model.Id</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Fecha de inicio</dt>
        <dd class="col-sm-10">@Model.StartDate.ToShortDateString()</dd>

        <dt class="col-sm-2">Fecha de fin</dt>
        <dd class="col-sm-10">@Model.EndDate.ToShortDateString()</dd>

        <dt class="col-sm-2">Personas</dt>
        <dd class="col-sm-10">@Model.NumberOfPeople</dd>
    </dl>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
