@model GlampingProyect.Web.Data.DTOs.ReservationDTO

@{
    ViewData["Title"] = "Editar Reserva";
}

<div class="pagetitle">
    <h1>Reservas</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Reservas</a></li>
            <li class="breadcrumb-item active">Editar Reserva</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">
    <div class="card">
        <div class="card-body">
            <h5 class="card-title text-primary">Editar Reserva</h5>

            <form asp-action="Edit" method="post" class="row g-3">
                <input type="hidden" asp-for="Id" />

                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="StartDate" type="date" class="form-control" />
                        <label asp-for="StartDate">Fecha de inicio</label>
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="EndDate" type="date" class="form-control" />
                        <label asp-for="EndDate">Fecha de fin</label>
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="NumberOfPeople" type="number" min="1" class="form-control" />
                        <label asp-for="NumberOfPeople">Número de personas</label>
                        <span asp-validation-for="NumberOfPeople" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <select asp-for="Status" class="form-select">
                            <option value="Pendiente">Pendiente</option>
                            <option value="Confirmada">Confirmada</option>
                            <option value="Cancelada">Cancelada</option>
                        </select>
                        <label asp-for="Status">Estado</label>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <select asp-for="PaymentStatus" class="form-select">
                            <option value="Pendiente">Pendiente</option>
                            <option value="Pagado">Pagado</option>
                            <option value="Reembolsado">Reembolsado</option>
                        </select>
                        <label asp-for="PaymentStatus">Estado de pago</label>
                        <span asp-validation-for="PaymentStatus" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="GlampingUnitId" type="number" min="1" class="form-control" />
                        <label asp-for="GlampingUnitId">Unidad Glamping</label>
                        <span asp-validation-for="GlampingUnitId" class="text-danger"></span>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-primary px-4">Actualizar</button>
                    <a asp-action="Index" class="btn btn-secondary ms-2">Volver</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
